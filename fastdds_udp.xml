<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fast DDS profile: disable shared-memory transport.

Docker containers do not share /dev/shm by default, so FastDDS SHM can cause
"topic is discovered but no data flows" between containers. Force UDP only.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="udp_only" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>udp_transport</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>

